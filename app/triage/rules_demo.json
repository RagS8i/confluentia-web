      "outcome": "EMERGENCY",
      "label": "Chest pain with breathlessness",
      "minimum_confidence": 0.6,
      "when": {
        "all": [
          {
            "fact_type": "symptom",
            "canonical_any": ["chest pain"],
            "status_any": ["present"],
            "min_confidence": 0.6
          },
          {
            "fact_type": "symptom",
            "canonical_any": ["shortness of breath"],
            "status_any": ["present"],
            "min_confidence": 0.6
          }
        ]
      },
      "explanation": "Illustrative demo rule: co-occurring chest pain and breathlessness should be assessed immediately by clinical staff. This is a workflow prompt, not a diagnosis."
    },
